[
  {
    "name": "YouTuber \u2014 Introduction & Embed Permission (Primary)",
    "type": "youtuber",
    "subject": "DJ from DownRange \u2014 wanted to tell you directly",
    "previewText": "I added you to the site \u2014 wanted to let you know directly.",
    "variables": [
      "{{firstName}}",
      "{{channelName}}",
      "{{portalUrl}}",
