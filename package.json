{
  "name": "downrange",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx next dev",
    "build": "npx next build",
    "start": "npx next start",
    "studio": "sanity dev",
    "studio:deploy": "sanity deploy",
    "agent": "node -r dotenv/config agent/index.js",
    "agent:news": "node -r dotenv/config agent/feeds/news.js",
    "agent:laws": "node -r dotenv/config agent/feeds/laws.js",
    "agent:releases": "node -r dotenv/config agent/feeds/releases.js",
    "agent:market": "node -r dotenv/config agent/feeds/market.js",
    "agent:video": "node -r dotenv/config agent/feeds/video.js",
    "agent:state": "node -r dotenv/config agent/feeds/state.js",
    "seed:states": "node -r dotenv/config scripts/seed-states.js",
    "seed:ammo": "node -r dotenv/config scripts/seed-ammo.js",
    "algolia:reindex": "curl -H 'Authorization: Bearer $CRON_SECRET' http://localhost:3000/api/algolia-sync",
    "lint": "npx next lint",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy/run-all.ps1",
    "deploy:step1": "powershell -ExecutionPolicy Bypass -File scripts/deploy/01-github-push.ps1",
    "deploy:step2": "powershell -ExecutionPolicy Bypass -File scripts/deploy/02-collect-keys.ps1",
    "deploy:step3": "powershell -ExecutionPolicy Bypass -File scripts/deploy/03-sanity-setup.ps1",
    "deploy:step4": "powershell -ExecutionPolicy Bypass -File scripts/deploy/04-vercel-deploy.ps1",
    "deploy:step5": "powershell -ExecutionPolicy Bypass -File scripts/deploy/05-algolia-setup.ps1",
    "deploy:verify": "powershell -ExecutionPolicy Bypass -File scripts/deploy/06-verify.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.26.0",
    "@clerk/nextjs": "6.12.0",
    "@sanity/client": "^6.0.0",
    "@sanity/vision": "^3.0.0",
    "@upstash/redis": "^1.28.0",
    "algoliasearch": "^4.23.0",
    "axios": "^1.6.0",
    "dotenv": "^16.4.0",
    "groq": "^3.0.0",
    "md5": "^2.3.0",
    "next": "14.2.29",
    "next-sanity": "^7.0.0",
    "next-themes": "^0.3.0",
    "node-cron": "^3.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^3.0.0",
    "rss-parser": "^3.13.0",
    "sanity": "^3.0.0",
    "styled-components": "^6.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  }
}