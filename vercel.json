{
  "crons": [
    {
      "path": "/api/agent?feed=news",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/agent?feed=laws",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/agent?feed=releases",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/agent?feed=market",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/agent?feed=video",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/agent?feed=state",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/newsletter",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/nics",
      "schedule": "0 10 1 * *"
    },
    {
      "path": "/api/site-health",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/site-health",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/site-health",
      "schedule": "0 20 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/studio/(.*)",
      "destination": "/studio/$1"
    }
  ],
  "functions": {
    "app/api/agent/route.js": {
      "maxDuration": 300
    },
    "app/api/admin/trigger/route.js": {
      "maxDuration": 300
    },
    "app/api/admin/status/route.js": {
      "maxDuration": 30
    },
    "app/api/deals/route.js": {
      "maxDuration": 30
    },
    "app/api/ranges/route.js": {
      "maxDuration": 30
    },
    "app/api/site-health/route.js": {
      "maxDuration": 300
    },
    "app/api/admin/backfill-articles/route.js": {
      "maxDuration": 300
    }
  }
}