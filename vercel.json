{
  "crons": [
    {
      "path": "/api/agent?feed=news",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/agent?feed=laws",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/agent?feed=releases",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/agent?feed=market",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/agent?feed=video",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/agent?feed=state",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/newsletter",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/nics",
      "schedule": "0 10 1 * *"
    },
    {
      "path": "/api/site-health",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/site-health",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/site-health",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/releases",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/outreach/queue/digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/intelligence",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/admin/fix-images?batch=500&force=false&cron=1",
      "schedule": "0 12-23,0-3 * * *"
    },
    {
      "path": "/api/admin/cron-health",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/admin/backfill-articles?batch=5",
      "schedule": "0 12-23,0-3 * * *"
    },
    {
      "path": "/api/agent?feed=goa",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/admin/fetch-article-images",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/nfa-wait-times",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/studio/(.*)",
      "destination": "/studio/$1"
    }
  ],
  "functions": {
    "app/api/agent/route.js": {
      "maxDuration": 300
    },
    "app/api/admin/trigger/route.js": {
      "maxDuration": 300
    },
    "app/api/admin/status/route.js": {
      "maxDuration": 30
    },
    "app/api/deals/route.js": {
      "maxDuration": 30
    },
    "app/api/ranges/route.js": {
      "maxDuration": 30
    },
    "app/api/site-health/route.js": {
      "maxDuration": 300
    },
    "app/api/admin/backfill-articles/route.js": {
      "maxDuration": 60
    },
    "app/api/admin/fix-images/route.js": {
      "maxDuration": 60
    },
    "app/api/cron/releases/route.js": {
      "maxDuration": 300
    },
    "app/api/admin/scrape-releases/route.js": {
      "maxDuration": 300
    },
    "app/api/system/alert/route.js": {
      "maxDuration": 30
    },
    "app/api/outreach/contacts/route.js": {
      "maxDuration": 30
    },
    "app/api/outreach/campaigns/route.js": {
      "maxDuration": 30
    },
    "app/api/outreach/templates/route.js": {
      "maxDuration": 30
    },
    "app/api/outreach/send/route.js": {
      "maxDuration": 300
    },
    "app/api/outreach/scrape/route.js": {
      "maxDuration": 60
    },
    "app/api/outreach/import/route.js": {
      "maxDuration": 60
    },
    "app/api/outreach/unsubscribe/route.js": {
      "maxDuration": 30
    },
    "app/api/outreach/templates/seed/route.js": {
      "maxDuration": 30
    },
    "app/api/outreach/history/route.js": {
      "maxDuration": 30
    },
    "app/api/outreach/manufacturers/route.js": {
      "maxDuration": 30
    },
    "app/api/outreach/send/preview/route.js": {
      "maxDuration": 30
    },
    "app/api/outreach/send/direct/route.js": {
      "maxDuration": 30
    },
    "app/api/outreach/dealers/route.js": {
      "maxDuration": 60
    },
    "app/api/outreach/holsters/route.js": {
      "maxDuration": 60
    },
    "app/api/outreach/queue/route.js": {
      "maxDuration": 300
    },
    "app/api/intelligence/route.js": {
      "maxDuration": 300
    },
    "app/api/admin/briefings/route.js": {
      "maxDuration": 30
    },
    "app/api/admin/cron-status/route.js": {
      "maxDuration": 60
    }
  }
}