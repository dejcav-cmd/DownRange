{
  "crons": [
    { "path": "/api/agent?feed=news",     "schedule": "*/15 * * * *" },
    { "path": "/api/agent?feed=laws",     "schedule": "0 */2 * * *" },
    { "path": "/api/agent?feed=releases", "schedule": "0 * * * *" },
    { "path": "/api/agent?feed=market",   "schedule": "*/30 * * * *" },
    { "path": "/api/agent?feed=video",    "schedule": "0 */4 * * *" },
    { "path": "/api/agent?feed=state",    "schedule": "0 8 * * *" },
    { "path": "/api/newsletter",          "schedule": "0 7 * * *" },
    { "path": "/api/nics",                "schedule": "0 10 1 * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "X-XSS-Protection",        "value": "1; mode=block" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/studio/(.*)", "destination": "/studio/$1" }
  ]
}
