# ── NEWS FEEDS ──────────────────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key_here
GNEWS_KEY=your_gnews_key_here

# ── LEGISLATION ─────────────────────────────────────────────────
CONGRESS_GOV_KEY=your_congress_gov_key_here
LEGISCAN_KEY=your_legiscan_key_here

# ── FIREARMS / RELEASES ─────────────────────────────────────────
GUNBROKER_KEY=your_gunbroker_dev_key
GUNBROKER_TOKEN=your_gunbroker_access_token

# ── VIDEO ────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# ── CMS (Sanity) ─────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_write_token
SANITY_WEBHOOK_SECRET=your_sanity_webhook_secret_random_string

# ── AUTH (Clerk) ─────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxx
CLERK_SECRET_KEY=sk_live_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── EMAIL (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
RESEND_AUDIENCE_ID=your_resend_audience_id
NEWSLETTER_TEST_EMAILS=you@youremail.com

# ── SEARCH (Algolia) ─────────────────────────────────────────────
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_ADMIN_KEY=your_algolia_admin_key
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_algolia_search_only_key

# ── CLAUDE AI ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── CACHE (Upstash Redis) ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── MONITORING (Discord) ──────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
DISCORD_ERRORS_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy
DISCORD_BREAKING_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy

# ── SECURITY ──────────────────────────────────────────────────────
CRON_SECRET=generate_a_random_32char_string_here
AGENT_SECRET=generate_another_random_32char_string
REVALIDATE_SECRET=generate_another_random_32char_string
